BringBtn.Font = Enum.Font.SourceSansBold
BringBtn.Parent = MainFrame

-- Helper function to search for player by partial name
local function GetPlayerByPartialName(name)
    name = name:lower()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and (player.Name:lower():find(name) or player.DisplayName:lower():find(name)) then
            return player
        end
    end
    return nil
end

BringBtn.MouseButton1Click:Connect(function()
    local targetText = TargetInput.Text
    if targetText == "" then return end
    
    local targetPlayer = GetPlayerByPartialName(targetText)
    
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            -- Teleports target player 3 studs in front of local character
            targetPlayer.Character.HumanoidRootPart.CFrame = myChar.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
        end
    end
end)
